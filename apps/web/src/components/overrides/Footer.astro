---
/**
 * Custom Footer component
 * Adds copyright with auto-updating year range and links to legal pages
 */
import type { Props } from '@astrojs/starlight/props';
import { t, type Lang } from '@/utils/i18n';

const { lang } = Astro.props as Props;
const labels = t(lang as Lang).footer;

const startYear = 2025;
const currentYear = new Date().getFullYear();
const yearDisplay = currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <span class="site-footer-copyright">&copy; {yearDisplay} Godojo</span>
    <nav class="site-footer-links">
      <a href={`/${lang}/privacy/`}>{labels.privacy}</a>
      <a href={`/${lang}/terms/`}>{labels.terms}</a>
      <a href={`/${lang}/cookies/`}>{labels.cookies}</a>
    </nav>
  </div>
</footer>
