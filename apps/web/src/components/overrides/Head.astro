---
/**
 * Custom Head component
 * - hreflang x-default (ru/en alternates are auto-generated by Starlight)
 * - og:type override (Starlight hardcodes "article" for all pages)
 * - Article-specific Open Graph meta (dates, author, tags)
 * - Global analytics events
 */
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from '@/components/Analytics.astro';

const { entry, lang } = Astro.props as Props;
const frontmatter = entry.data;
const pathname = Astro.url.pathname;
const site = 'https://godojo.dev';

// Extract slug (remove language prefix) and build English fallback URL
let slug = pathname;
if (pathname.startsWith('/ru/')) {
  slug = pathname.slice(3);
} else if (pathname.startsWith('/en/')) {
  slug = pathname.slice(3);
}

const enUrl = `${site}/en${slug}`;

// Detect article pages (have author or updatedAt from sync script)
const isArticle = frontmatter.author || frontmatter.updatedAt;
---

<Default {...Astro.props}><slot /></Default>
<link rel="alternate" hreflang="x-default" href={enUrl} />

{/* Override og:type: Starlight hardcodes "article", but non-article pages should be "website" */}
{!isArticle && (
  <meta property="og:type" content="website" />
)}

{/* Article-specific OG tags for richer social sharing */}
{isArticle && frontmatter.updatedAt && (
  <meta property="article:modified_time" content={`${frontmatter.updatedAt}T00:00:00Z`} />
)}
{isArticle && frontmatter.authorName && (
  <meta property="article:author" content={frontmatter.authorName} />
)}
{isArticle && (
  <meta property="article:section" content="Education" />
  <meta property="article:tag" content="Go" />
  <meta property="article:tag" content="Golang" />
  <meta property="article:tag" content="Programming" />
)}

{/* WebSite schema: tells Google the preferred site name instead of showing the domain */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Godojo",
  "alternateName": lang === 'ru' ? "Годожо" : "Godojo — Go Tutorial",
  "url": site
})} />

<Analytics />
