---
/**
 * Creative 404 page — Go-themed "nil" error
 * Language detection via data-lang attribute, no flash
 */
---

<div class="not-found" id="not-found">
  <div class="not-found-code">nil</div>
  <div class="not-found-comment">
    <span data-lang="ru">// страница не найдена</span>
    <span data-lang="en">// page not found</span>
  </div>

  <div class="not-found-block">
    <pre><code><span class="kw">package</span> <span class="pkg">main</span>

<span class="kw">import</span> <span class="str">"fmt"</span>

<span class="kw">func</span> <span class="fn">main</span>() &#123;
    page, err := http.<span class="fn">Get</span>(url)
    <span class="kw">if</span> err != <span class="type">nil</span> &#123;
        fmt.<span class="fn">Println</span>(<span class="str">"<span data-lang="ru">404: страница не найдена</span><span data-lang="en">404: page not found</span>"</span>)
        fmt.<span class="fn">Println</span>(<span class="str">"<span data-lang="ru">Попробуйте главную или оглавление</span><span data-lang="en">Try the homepage or table of contents</span>"</span>)
    &#125;
&#125;</code></pre>
  </div>

  <div class="not-found-actions">
    <a href="/en/" class="not-found-btn" data-home>
      <span data-lang="ru">go run home.go</span>
      <span data-lang="en">go run home.go</span>
    </a>
  </div>
</div>

<script is:inline>
  // Runs synchronously — detect lang from URL path or navigator
  (function() {
    var path = location.pathname;
    var lang = path.startsWith('/ru') ? 'ru' : path.startsWith('/en') ? 'en'
      : (navigator.language && navigator.language.startsWith('ru') ? 'ru' : 'en');
    var root = document.getElementById('not-found');
    if (!root) return;
    root.setAttribute('data-detected-lang', lang);
    var home = root.querySelector('[data-home]');
    if (home) home.href = '/' + lang + '/';
  })();
</script>

<style is:global>
  /* Language switching: hide all [data-lang] by default, show matching */
  #not-found [data-lang] { display: none; }
  #not-found[data-detected-lang="ru"] [data-lang="ru"] { display: inline; }
  #not-found[data-detected-lang="en"] [data-lang="en"] { display: inline; }
  /* Fallback: if JS hasn't run yet, show English */
  #not-found:not([data-detected-lang]) [data-lang="en"] { display: inline; }

  .not-found {
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
    padding: 1rem;
  }

  .not-found-code {
    font-size: 5rem;
    font-weight: 800;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    color: var(--sl-color-accent);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .not-found-comment {
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 1rem;
    color: #6a9955;
    margin-bottom: 2rem;
  }

  .not-found-block {
    background: var(--sl-color-bg-sidebar, #171B19);
    border: 1px solid var(--sl-color-gray-6, #262B27);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    text-align: left;
    margin-bottom: 2rem;
    overflow-x: auto;
  }

  .not-found-block pre {
    margin: 0;
    background: none !important;
    border: none !important;
    padding: 0 !important;
  }

  .not-found-block code {
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--sl-color-white, #F3F8FA);
    background: none !important;
    border: none !important;
    padding: 0 !important;
  }

  .not-found-block .kw { color: #c586c0; }
  .not-found-block .fn { color: #dcdcaa; }
  .not-found-block .str { color: #ce9178; }
  .not-found-block .pkg { color: #4ec9b0; }
  .not-found-block .type { color: #569cd6; }

  .not-found-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.75rem;
    border-radius: 6px;
    text-decoration: none;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-weight: 600;
    font-size: 0.95rem;
    color: #4ec9b0;
    background: var(--sl-color-bg-sidebar, #171B19);
    border: 1px solid var(--sl-color-gray-6, #262B27);
    transition: all 0.2s ease;
  }

  .not-found-btn:hover {
    border-color: var(--sl-color-accent, #3b82f6);
    color: var(--sl-color-accent, #3b82f6);
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .not-found-code { font-size: 3.5rem; }
    .not-found-block code { font-size: 0.75rem; }
    .not-found-block { padding: 1rem; }
  }
</style>
