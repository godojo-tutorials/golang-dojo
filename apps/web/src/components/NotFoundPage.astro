---
/**
 * Creative 404 page — Go-themed "nil" error
 * Detects browser language for ru/en content
 */
---

<div class="not-found">
  <div class="not-found-code">nil</div>
  <div class="not-found-comment">// page not found</div>

  <div class="not-found-block">
    <pre><code><span class="kw">package</span> <span class="pkg">main</span>

<span class="kw">import</span> <span class="str">"fmt"</span>

<span class="kw">func</span> <span class="fn">main</span>() &#123;
    page, err := http.<span class="fn">Get</span>(url)
    <span class="kw">if</span> err != <span class="type">nil</span> &#123;
        fmt.<span class="fn">Println</span>(<span class="str">"<span class="msg-404">404: page not found</span>"</span>)
        fmt.<span class="fn">Println</span>(<span class="str">"<span class="msg-hint">Try the homepage or table of contents</span>"</span>)
    &#125;
&#125;</code></pre>
  </div>

  <div class="not-found-actions">
    <a href="/" class="not-found-btn primary" data-home>
      <span class="btn-label-en">Home</span>
      <span class="btn-label-ru" style="display:none">На главную</span>
    </a>
    <a href="/" class="not-found-btn secondary" data-toc>
      <span class="btn-label-en">Table of Contents</span>
      <span class="btn-label-ru" style="display:none">Оглавление</span>
    </a>
  </div>
</div>

<script>
  // Detect language and localize
  const isRu = navigator.language?.startsWith('ru');
  const lang = isRu ? 'ru' : 'en';

  // Update links
  document.querySelector('[data-home]')?.setAttribute('href', `/${lang}/`);
  document.querySelector('[data-toc]')?.setAttribute('href', `/${lang}/`);

  // Swap button labels
  document.querySelectorAll('.btn-label-en').forEach(el => {
    (el as HTMLElement).style.display = isRu ? 'none' : '';
  });
  document.querySelectorAll('.btn-label-ru').forEach(el => {
    (el as HTMLElement).style.display = isRu ? '' : 'none';
  });

  // Swap messages
  const msg404 = document.querySelector('.msg-404');
  const msgHint = document.querySelector('.msg-hint');
  if (isRu && msg404) msg404.textContent = '404: страница не найдена';
  if (isRu && msgHint) msgHint.textContent = 'Попробуйте главную или оглавление';

  // Update comment
  const comment = document.querySelector('.not-found-comment');
  if (isRu && comment) comment.textContent = '// страница не найдена';
</script>

<style>
  .not-found {
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
    padding: 1rem;
  }

  .not-found-code {
    font-size: 5rem;
    font-weight: 800;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    color: var(--sl-color-accent);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .not-found-comment {
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 1rem;
    color: #6a9955;
    margin-bottom: 2rem;
  }

  .not-found-block {
    background: var(--sl-color-bg-sidebar, #171B19);
    border: 1px solid var(--sl-color-gray-6, #262B27);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    text-align: left;
    margin-bottom: 2rem;
    overflow-x: auto;
  }

  .not-found-block pre {
    margin: 0;
    background: none !important;
    border: none !important;
    padding: 0 !important;
  }

  .not-found-block code {
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--sl-color-white, #F3F8FA);
    background: none !important;
    border: none !important;
    padding: 0 !important;
  }

  .not-found-block .kw { color: #c586c0; }
  .not-found-block .fn { color: #dcdcaa; }
  .not-found-block .str { color: #ce9178; }
  .not-found-block .pkg { color: #4ec9b0; }
  .not-found-block .type { color: #569cd6; }

  .not-found-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .not-found-btn.primary {
    background: var(--sl-color-accent, #3b82f6);
    color: white;
  }

  .not-found-btn.primary:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }

  .not-found-btn.secondary {
    background: transparent;
    color: var(--sl-color-white, #F3F8FA);
    border: 1px solid var(--sl-color-gray-6, #262B27);
  }

  .not-found-btn.secondary:hover {
    border-color: var(--sl-color-gray-4, #707574);
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .not-found-code { font-size: 3.5rem; }
    .not-found-block code { font-size: 0.75rem; }
    .not-found-block { padding: 1rem; }
  }
</style>
